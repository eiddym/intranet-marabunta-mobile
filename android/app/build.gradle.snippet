// Fragmento de referencia para android/app/build.gradle (o build.gradle.kts)
// Al ejecutar `flutter create --org com.marabuntarl --project-name intranet_marabunta .`,
// asegúrate de conservar `appAuthRedirectScheme` y `minSdk >= 23`.

android {
    namespace = "com.marabuntarl.intranet"
    defaultConfig {
        applicationId = "com.marabuntarl.intranet"
        minSdk = 23
        manifestPlaceholders["appAuthRedirectScheme"] = "com.marabuntarl.intranet"
    }
}

